# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the service dashboard instead.
#
# This is the standalone admin API (backend-admin/), separate from the public
# shop's backend/ service. It talks to the SAME MongoDB database — admin and
# shop are two API services sharing one data store, not two separate datasets.

# Port the Express server listens on (Render sets this automatically in prod).
# Defaults to 5001 so it doesn't collide with backend/'s default of 5000 when
# running both locally at once.
PORT=5001

# MongoDB connection string — use the SAME value as backend/.env so both
# services read/write the same products, orders, sales, customers, etc.
# Local dev:  mongodb://127.0.0.1:27017/crackers-billing
# Production: use a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/crackers-billing

# Set to "production" on the deploy host so the backend serves the built
# frontend (frontend/admin/dist) instead of the "Admin backend is running" message.
NODE_ENV=development

# Admin authentication (required — the server refuses to start without these).
# JWT_SECRET: long random string signing admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Can be different from backend/'s JWT_SECRET — tokens aren't shared between
# the two services, each issues and verifies its own.
JWT_SECRET=replace_with_a_long_random_string

# ADMIN_USERNAME / ADMIN_PASSWORD_HASH: the single shop-owner login used on /login.
# Use the SAME values as backend/.env so the owner logs in with one set of
# credentials on either app. Generate the hash for a chosen password with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Optional, production only: comma-separated extra origins allowed to call this
# API cross-origin (e.g. a custom domain in front of Render). The service's own
# Render URL (RENDER_EXTERNAL_URL) is always allowed automatically, and this is
# unnecessary for the default single-service setup where the frontend is served
# from the same origin. Leave unset in development — CORS is open there.
CORS_ORIGIN=
