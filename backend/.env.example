# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the service dashboard instead.

# Port the Express server listens on (Render sets this automatically in prod)
PORT=5000

# MongoDB connection string.
# Local dev:  mongodb://127.0.0.1:27017/crackers-billing
# Production: use a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/crackers-billing

# Set to "production" on the deploy host so the backend serves the built
# frontend (frontend/billing/dist) instead of the "Backend is running" message.
NODE_ENV=development

# Admin authentication (required — the server refuses to start without these).
# JWT_SECRET: long random string signing admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ADMIN_USERNAME / ADMIN_PASSWORD_HASH: the single shop-owner login used on /login.
# Generate the hash for a chosen password with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash
